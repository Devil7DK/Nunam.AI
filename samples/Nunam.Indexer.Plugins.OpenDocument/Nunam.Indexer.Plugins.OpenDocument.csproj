<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Writes the .deps.json the indexer's plugin loader resolves this plugin's own dependencies from. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!-- The indexer supplies the contracts at run time; a copy beside the plugin would be ignored anyway. -->
    <ProjectReference Include="..\..\Nunam.Indexer.Abstractions\Nunam.Indexer.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

</Project>
