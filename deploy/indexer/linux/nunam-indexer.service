# systemd unit for the Linux indexer, installed by the .deb and .rpm packages (build-packages.sh).
# Settings: /etc/nunam-indexer/appsettings.Local.json, linked from the install folder.
[Unit]
Description=Nunam Indexer
After=network-online.target remote-fs.target
Wants=network-online.target

[Service]
Type=notify
User=nunam
WorkingDirectory=/usr/lib/nunam-indexer
ExecStart=/usr/lib/nunam-indexer/Nunam.Indexer
Restart=on-failure
RestartSec=30
Environment=DOTNET_ENVIRONMENT=Production

# Sandbox: the indexer only reads files and talks to Postgres. It sees the filesystem read-only
# (watch paths under /home included) and writes only to its private /tmp (video frames).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
UMask=0077
# Not MemoryDenyWriteExecute: the .NET JIT needs writable+executable memory.
# Not ProtectProc=invisible: it hides PID 1, so .NET doesn't detect systemd and never reports ready.

[Install]
WantedBy=multi-user.target
