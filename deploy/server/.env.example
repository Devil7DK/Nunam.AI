# Copy to .env beside compose.yaml, chmod 600, and fill in.

# Where the Nunam images come from, and which build. A dated tag (20261121-abc1234) pins one build;
# latest follows the newest.
NUNAM_REGISTRY=registry.dineshkumar.dev
NUNAM_TAG=latest

# Owner of the database; only the migrations run as it. The API and AI worker have their own logins,
# and each indexed machine gets one from add-indexer-login.sh.
POSTGRES_USER=nunam
POSTGRES_PASSWORD=
POSTGRES_DB=nunam
NUNAM_AIWORKER_PASSWORD=
NUNAM_API_PASSWORD=

# Postgres is published on the LAN because indexers write to it directly.
POSTGRES_PORT=5432
UI_PORT=3000
# Address (or CIDR) of an HTTPS reverse proxy in front of the UI, if any. Its X-Forwarded-For and
# X-Forwarded-Proto are trusted; nobody else's are.
# NUNAM_TRUSTED_PROXY=

# The Ollama server with the GPU. Jobs wait as Pending while it is unreachable.
AI_PROVIDER=Ollama
AI_BASE_URL=http://ollama-host:11434
AI_CHAT_MODEL=gemma4:12b-it-qat
AI_EMBEDDING_MODEL=bge-m3

TZ=Etc/UTC
