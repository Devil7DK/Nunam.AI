# Copy to .env beside compose.yaml, chmod 600, and fill in.

# Where the Nunam images come from, and which build. GitHub Actions pushes every commit on master
# there as latest and as a dated tag (20261121-abc1234), which pins one build.
NUNAM_REGISTRY=ghcr.io/devil7dk
NUNAM_TAG=latest

# Owner of the database; only the migrations run as it. The API has its own login. Indexers and the
# AI worker go through the API.
POSTGRES_USER=nunam
POSTGRES_PASSWORD=
POSTGRES_DB=nunam
NUNAM_API_PASSWORD=

# The AI worker signs in to the API with this: openssl rand -base64 32
NUNAM_WORKER_TOKEN=

UI_PORT=3000
# HTTPS port. It serves tls/cert.pem and tls/key.pem beside the Compose file; with neither there, a
# self-signed pair is created on first start, which the Add machine command pins.
UI_HTTPS_PORT=3443
# Names and addresses the self-signed certificate is made for (only when it is created).
# NUNAM_TLS_NAMES=nunam.lan,192.168.1.20
# Whether new machines pin the certificate: auto pins one not issued by a public authority.
# NUNAM_TLS_PIN=auto
# Address (or CIDR) of an HTTPS reverse proxy in front of the UI, if any. Its X-Forwarded-For and
# X-Forwarded-Proto are trusted; nobody else's are.
# NUNAM_TRUSTED_PROXY=

# The Ollama server with the GPU, for embeddings. The first describe provider is created at this
# address too; describe providers are then managed on the web UI's AI page. Jobs wait while it is unreachable.
AI_PROVIDER=Ollama
AI_BASE_URL=http://ollama-host:11434
AI_EMBEDDING_MODEL=bge-m3

TZ=Etc/UTC

# Encrypts the API keys of describe providers (cloud models) stored in the database. Without it, only
# providers without a key can be added. Make one with: openssl rand -base64 32
# Keep it: a new key means entering every provider's API key again.
NUNAM_SECRETS_KEY=
