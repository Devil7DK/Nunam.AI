{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Server": {
    "Url": "http://localhost:5033"
  },
  "Indexer": {
    "WatchPaths": [ "../sample-data" ],
    "MaxFileSizeMb": 32,
    "MaxPreviewMb": 8,
