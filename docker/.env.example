# Copy to docker/.env and fill in. docker/.env is git-ignored.

# Owner of the database; runs migrations. The AI worker and API use their own logins below;
# each indexed machine gets its own login from docker/add-indexer-login.sh.
POSTGRES_USER=nunam
POSTGRES_PASSWORD=change-me-owner
POSTGRES_DB=nunam
# Indexers on other machines connect here, so it's published on the LAN.
POSTGRES_PORT=5432

NUNAM_AIWORKER_PASSWORD=change-me-aiworker
NUNAM_API_PASSWORD=change-me-api

# Ollama on the homelab's GPU container. The AI worker keeps jobs pending while it is unreachable.
AI_PROVIDER=Ollama
AI_BASE_URL=http://192.168.7.113:11434
AI_CHAT_MODEL=gemma4:12b-it-qat
AI_EMBEDDING_MODEL=bge-m3

# Port the web UI is served on.
UI_PORT=3000
# Address (or CIDR) of an HTTPS reverse proxy in front of the UI, if any. Its X-Forwarded-For and
# X-Forwarded-Proto are trusted; nobody else's are.
# NUNAM_TRUSTED_PROXY=172.18.0.1/32
