# Copy to docker/.env and fill in. docker/.env is git-ignored.

# Owner of the database; runs migrations. Indexers and services use their own logins below.
POSTGRES_USER=nunam
POSTGRES_PASSWORD=change-me-owner
POSTGRES_DB=nunam
# Indexers on other machines connect here, so it's published on the LAN.
POSTGRES_PORT=5432

NUNAM_INDEXER_PASSWORD=change-me-indexer
NUNAM_AIWORKER_PASSWORD=change-me-aiworker
NUNAM_API_PASSWORD=change-me-api

# Ollama on the GPU machine. The AI worker keeps jobs pending while it is unreachable.
AI_PROVIDER=Ollama
AI_BASE_URL=http://gaming-pc.lan:11434
AI_CHAT_MODEL=qwen2.5vl:7b
AI_EMBEDDING_MODEL=nomic-embed-text

# Port the web UI is served on.
UI_PORT=3000
