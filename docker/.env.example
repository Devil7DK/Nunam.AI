# Copy to docker/.env and fill in. docker/.env is git-ignored.

# Owner of the database; runs migrations. The API uses its own login below; indexers and the AI
# worker go through the API.
POSTGRES_USER=nunam
POSTGRES_PASSWORD=change-me-owner
POSTGRES_DB=nunam
NUNAM_API_PASSWORD=change-me-api

# The AI worker signs in to the API with this: openssl rand -base64 32
NUNAM_WORKER_TOKEN=change-me-worker-token

# The Ollama server with the GPU. The AI worker keeps jobs pending while it is unreachable.
AI_PROVIDER=Ollama
AI_BASE_URL=http://ollama-host:11434
AI_CHAT_MODEL=gemma4:12b-it-qat
AI_EMBEDDING_MODEL=bge-m3

# Port the web UI is served on.
UI_PORT=3000
# Address (or CIDR) of an HTTPS reverse proxy in front of the UI, if any. Its X-Forwarded-For and
# X-Forwarded-Proto are trusted; nobody else's are.
# NUNAM_TRUSTED_PROXY=172.18.0.1/32
