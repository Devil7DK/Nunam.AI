# Serves the built UI and forwards /api to the API container, so the browser talks to one origin.
# A template: the nginx image substitutes ${NUNAM_TRUSTED_PROXY} at start.

# An HTTPS proxy in front (NUNAM_TRUSTED_PROXY) passes the client's address and scheme on; anyone
# else sending those headers is ignored, or they could dodge the sign-in limit per address.
set_real_ip_from ${NUNAM_TRUSTED_PROXY};
real_ip_header X-Forwarded-For;

geo $realip_remote_addr $from_trusted_proxy {
    default 0;
    ${NUNAM_TRUSTED_PROXY} 1;
}

map "$from_trusted_proxy:$http_x_forwarded_proto" $client_scheme {
    default $scheme;
    "1:https" https;
}

server {
    listen 80;
    root /usr/share/nginx/html;
    server_tokens off;
    client_max_body_size 64k;

    location /api/ {
        proxy_pass http://nunam-api:8080;
        proxy_set_header Host $host;
        # Replaces whatever the client sent: the API trusts these to rate-limit sign-ins per address.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $client_scheme;
        proxy_read_timeout 60s;
    }

    # Indexers and the AI worker: parse results carry extracted text and a preview image, and the
    # install commands download the indexer's packages.
    location /api/agent/ {
        proxy_pass http://nunam-api:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $client_scheme;
        client_max_body_size 32m;
        proxy_read_timeout 120s;
    }

    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
