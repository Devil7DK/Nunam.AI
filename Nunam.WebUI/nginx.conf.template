# Serves the built UI and forwards /api to the API container, so the browser talks to one origin.
# A template: the nginx image substitutes ${NUNAM_TRUSTED_PROXY} at start.

# An HTTPS proxy in front (NUNAM_TRUSTED_PROXY) passes the client's address and scheme on; anyone
# else sending those headers is ignored, or they could dodge the sign-in limit per address.
set_real_ip_from ${NUNAM_TRUSTED_PROXY};
real_ip_header X-Forwarded-For;

geo $realip_remote_addr $from_trusted_proxy {
    default 0;
    ${NUNAM_TRUSTED_PROXY} 1;
}

map "$from_trusted_proxy:$http_x_forwarded_proto" $client_scheme {
    default $scheme;
    "1:https" https;
}

server {
    listen 80;
    root /usr/share/nginx/html;
    server_tokens off;
    client_max_body_size 64k;
    include /etc/nginx/snippets/nunam-locations.conf;
}

server {
    listen 443 ssl;
    http2 on;
    root /usr/share/nginx/html;
    server_tokens off;
    client_max_body_size 64k;

    ssl_certificate ${NUNAM_TLS_CERT};
    ssl_certificate_key ${NUNAM_TLS_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:nunam:1m;
    ssl_session_timeout 1d;

    # Fingerprints of this certificate, for the Add machine command to pin. Not through a proxy in
    # front: its certificate is the one machines would see.
    location = /certificate.json {
        if ($from_trusted_proxy) {
            return 404;
        }
        alias /etc/nunam/run/certificate.json;
        default_type application/json;
        add_header Cache-Control "no-store";
    }

    include /etc/nginx/snippets/nunam-locations.conf;
}
