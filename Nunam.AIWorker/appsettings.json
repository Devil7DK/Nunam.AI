{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Server": {
    "Url": "http://nunam-api:8080",
    "Token": null
  },
  "AI": {
    "Provider": "Ollama",
    "BaseUrl": "http://localhost:11434",
    "EmbeddingModel": "bge-m3",
    "EmbeddingDimensions": 1024
  },
  "AIWorker": {
    "ProviderRefreshSeconds": 30,
    "DescribeTimeoutSeconds": 300,
    "EmbedBatchSize": 16,
    "ContentCharLimit": 2000,
    "IdlePollSeconds": 5,
    "MinBackoffSeconds": 5,
    "MaxBackoffSeconds": 120,
    "StaleJobMinutes": 30
  }
}
